// ============================================================
// BuySell365 PRO · ORO — Script Exclusivo para Gold Premium
// Replica la lógica exacta del bot (bot.py) para detección
// de señales de oro con las 3 estrategias + Multi-IA scoring
// ============================================================
// NOMENCLATURA ORO:
//   TradingView: XAUUSD, OANDA:XAUUSD, TVC:GOLD
//   Bot (bot.py): GC=F (Yahoo Finance)
//   MT5 XM:      GOLD  (NO existe XAUUSD en XM MT5)
//   Este script detecta: XAU, GC, GOLD — todos = ORO
// ============================================================

//@version=6
indicator("BuySell365 PRO · ORO", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=200)

// ═══════════════════════════════════════════════════
// DETECCIÓN DE ORO (debe ser XAUUSD/GC/GOLD)
// ═══════════════════════════════════════════════════

isGold = str.contains(str.upper(syminfo.tickerid), "XAU") or str.contains(str.upper(syminfo.tickerid), "GOLD") or str.contains(str.upper(syminfo.tickerid), "GC")
if not isGold
    runtime.error("⚠️ BuySell365 PRO ORO: Este script es SOLO para ORO (XAUUSD/GOLD/GC). Cámbialo al chart de oro.")

// ═══════════════════════════════════════════════════
// PARÁMETROS FIJOS DEL BOT (bot.py líneas 2359-2363)
// ═══════════════════════════════════════════════════

// Thresholds de detección (NO ajustables — calibrados en bot.py)
RSI_OS      = 36        // Oversold (bot: rsi_os = 36)
RSI_OB      = 64        // Overbought (bot: rsi_ob = 64)
ADX_MIN     = 15        // Tendencia mínima (bot: adx_min = 15)
BB_SQUEEZE  = 0.012     // Bollinger squeeze <1.2% (bot: bb_squeeze = 0.012)
VOL_MIN     = 0.8       // Volumen mínimo ratio (bot: vol_ratio >= 0.8)
MIN_ATR     = 0.20      // ATR mínimo $0.20 (bot: min_atr = 0.2)

// TP/SL multiplicadores ATR (calibrados para oro $5000+)
// Antes: 0.5/0.75 → SL $12, TP1 $18 → SL demasiado apretado → 15% WR = RUINA
// Ahora: 1.0/1.5 → SL $25, TP1 $37 → room to breathe → R:R 1.5:1
SL_MULT     = 1.0       // SL = 1.0 × ATR 1H (~$25)
TP1_MULT    = 1.5       // TP1 = 1.5 × ATR 1H (~$37) → R:R 1.50:1
TP2_MULT    = 3.0       // TP2 = 3.0 × ATR 1H (~$75)
TP3_MULT    = 5.0       // TP3 = 5.0 × ATR 1H (~$125)
MIN_SL      = 10.0      // SL mínimo $10 (oro es volátil en 15m)
MAX_SL_MULT = 2.0       // SL máximo = 2.0 × ATR (safety cap)

// ═══════════════════════════════════════════════════
// INPUTS OPCIONALES (ajuste fino del usuario)
// ═══════════════════════════════════════════════════

grpAdj      = "Ajustes TP/SL"
tpAdj       = input.float(1.0, "Multiplicar TP", minval=0.5, maxval=2.0, step=0.1, group=grpAdj)
slAdj       = input.float(1.0, "Multiplicar SL", minval=0.5, maxval=2.0, step=0.1, group=grpAdj)

grpLvl      = "Niveles de Señal"
showPremium = input.bool(true,  "Mostrar PREMIUM", group=grpLvl)
showValid   = input.bool(true,  "Mostrar VÁLIDA",  group=grpLvl)

grpSMC      = "Smart Money"
smcEnabled  = input.bool(true,  "Activar SMC",           group=grpSMC)
obLookback  = input.int(10,     "OB Lookback", minval=5, maxval=30, group=grpSMC)

grpFilt     = "Filtros"
sessionFilt = input.bool(true,  "Solo London/NY (recomendado para alertas)", group=grpFilt)
ema200Filt  = input.bool(false, "Filtro EMA200 estricto", group=grpFilt)
volFilterOn = input.bool(true,  "Filtro Volumen",         group=grpFilt)

grpVis      = "Visual"
showEMAs    = input.bool(true,  "EMAs",          group=grpVis)
showOB      = input.bool(true,  "Order Blocks",  group=grpVis)
showFVG     = input.bool(true,  "FVGs",          group=grpVis)
showTPSL    = input.bool(true,  "TP/SL lines",   group=grpVis)
showTable   = input.bool(true,  "Tabla Info",    group=grpVis)
showStats   = input.bool(true,  "Tabla Stats",   group=grpVis)

// Multiplicadores finales
finalTp1 = TP1_MULT * tpAdj
finalTp2 = TP2_MULT * tpAdj
finalTp3 = TP3_MULT * tpAdj
finalSl  = SL_MULT  * slAdj

// ═══════════════════════════════════════════════════
// INDICADORES BASE (bot.py líneas 2065-2295)
// ═══════════════════════════════════════════════════

// EMAs (bot: ema9, ema20, ema50, ema200)
ema9   = ta.ema(close, 9)
ema20  = ta.ema(close, 20)
ema50  = ta.ema(close, 50)
ema200 = ta.ema(close, 200)

// RSI(14) (bot: ta.rsi(close, length=14))
rsiVal = ta.rsi(close, 14)

// MACD(12, 26, 9) (bot: ta.macd(close, fast=12, slow=26, signal=9))
[macdLine, signalLine, histLine] = ta.macd(close, 12, 26, 9)

// ATR(14) timeframe actual
atrVal = ta.atr(14)
atrPct = (atrVal / close) * 100

// Bollinger Bands(20, 2) (bot: ta.bbands(close, length=20, std=2))
// ta.bb() retorna [basis, upper, lower] — NO [upper, basis, lower]
[bbBasis, bbUpper, bbLower] = ta.bb(close, 20, 2.0)
bbWidthPct = (bbUpper - bbLower) / close  // Como fracción (bot: bb_rango_pct)

// ADX(14) + DI+/DI- (bot: ta.adx(high, low, close, length=14))
[diPlus, diMinus, adxVal] = ta.dmi(14, 14)

// Estocástico(14, 3) (bot: ta.stoch(high, low, close, k=14, d=3))
// ta.stoch(source, high, low, length) → retorna %K raw (4 params, no 6)
_stochRaw = ta.stoch(close, high, low, 14)
stochK    = ta.sma(_stochRaw, 3)   // %K suavizado (SMA 3)
stochD    = ta.sma(stochK, 3)      // %D (SMA 3 del %K)

// Volumen: ratio vs SMA(20) — proxy ATR para futuros sin volumen
volSMA   = ta.sma(volume, 20)
_atrRecent = ta.sma(atrVal, 5)
_atrAvg    = ta.sma(atrVal, 20)
volRatio = volume > 0 ? nz(volume / volSMA, 1.0) : nz(_atrRecent / _atrAvg, 1.0)

// VWAP
vwapVal = ta.vwap(close)

// Vela con cuerpo real (no doji) — bot: vela_con_cuerpo
bodyPct    = math.abs(close - open) / math.max(high - low, 0.01)
velaCuerpo = bodyPct > 0.3  // Cuerpo > 30% del rango

// ═══════════════════════════════════════════════════
// MULTI-TIMEFRAME 1H (bot: confirmar_tendencia_1h)
// ═══════════════════════════════════════════════════

// ATR 1H para TP/SL (bot usa ATR 1H como base)
atr1H = request.security(syminfo.tickerid, "60", ta.atr(14))

// Confirmación de tendencia en 1H
ema20_1h  = request.security(syminfo.tickerid, "60", ta.ema(close, 20))
ema50_1h  = request.security(syminfo.tickerid, "60", ta.ema(close, 50))
rsi_1h    = request.security(syminfo.tickerid, "60", ta.rsi(close, 14))
[_dp1h, _dm1h, adx_1h] = request.security(syminfo.tickerid, "60", ta.dmi(14, 14))
[macd_1h, signal_1h, _hist1h] = request.security(syminfo.tickerid, "60", ta.macd(close, 12, 26, 9))

mtf1hBull = ema20_1h > ema50_1h and macd_1h > signal_1h and rsi_1h > 40 and rsi_1h < 75
mtf1hBear = ema20_1h < ema50_1h and macd_1h < signal_1h and rsi_1h > 25 and rsi_1h < 60

// ═══════════════════════════════════════════════════
// DETECCIÓN DE DIVERGENCIAS RSI (bot líneas 2155-2173)
// ═══════════════════════════════════════════════════

// Lookback 20 velas para divergencias
_precio20  = ta.lowest(low, 20)
_precio20H = ta.highest(high, 20)
_rsi20L    = ta.lowest(rsiVal, 20)
_rsi20H    = ta.highest(rsiVal, 20)

// Divergencia alcista: precio hace lower low, RSI hace higher low
divAlcista = (low <= _precio20 * 1.002) and (rsiVal > _rsi20L * 1.15)

// Divergencia bajista: precio hace higher high, RSI hace lower high
divBajista = (high >= _precio20H * 0.998) and (rsiVal < _rsi20H * 0.85)

// ═══════════════════════════════════════════════════
// SOPORTE / RESISTENCIA (bot líneas 2176-2210)
// ═══════════════════════════════════════════════════

swingHigh = ta.pivothigh(high, 5, 5)
swingLow  = ta.pivotlow(low, 5, 5)

var float lastSH = na
var float lastSL_pivot = na
if not na(swingHigh)
    lastSH := swingHigh
if not na(swingLow)
    lastSL_pivot := swingLow

// Cercanía a soporte/resistencia (dentro de 0.5%)
cercaSoporte     = not na(lastSL_pivot) and (close - lastSL_pivot) / close < 0.005 and close > lastSL_pivot
cercaResistencia = not na(lastSH) and (lastSH - close) / close < 0.005 and close < lastSH

// ═══════════════════════════════════════════════════
// RÉGIMEN DE MERCADO (bot líneas 2278-2287)
// ═══════════════════════════════════════════════════

regimeTend = adxVal > 25
regimeRang = adxVal < 20
regimeVol  = bbWidthPct * 100 > 2.5  // BB width > 2.5% del precio
regimeTran = not regimeTend and not regimeRang and not regimeVol

// Bloqueos por régimen (bot líneas 2321-2345)
regimeBlockTran = regimeTran and adxVal < 18
regimeBlockVol  = regimeVol and volRatio < 1.0
regimeBlockRang = regimeRang and not (divAlcista or divBajista or rsiVal < RSI_OS or rsiVal > RSI_OB)

regimeOK = not regimeBlockTran and not regimeBlockVol and not regimeBlockRang

// ═══════════════════════════════════════════════════
// SMART MONEY CONCEPTS (del guaro_v5.pine)
// ═══════════════════════════════════════════════════

// BOS / CHoCH
bosUp   = smcEnabled and not na(lastSH) and close > lastSH and close[1] <= lastSH
bosDown = smcEnabled and not na(lastSL_pivot) and close < lastSL_pivot and close[1] >= lastSL_pivot

var int mktTrend = 0
if bosUp
    mktTrend := 1
if bosDown
    mktTrend := -1

chochUp   = bosUp   and mktTrend[1] == -1
chochDown = bosDown and mktTrend[1] == 1

// Order Blocks
var float obBullH = na, var float obBullL = na, var int obBullBar = na
var float obBearH = na, var float obBearL = na, var int obBearBar = na

impulsoThr  = 0.4  // Umbral oro (del v5 línea 166)
impulsoUp   = close > open and close[1] > open[1] and (close - open) > atrVal * impulsoThr
impulsoDown = close < open and close[1] < open[1] and (open - close) > atrVal * impulsoThr

if smcEnabled and impulsoUp
    for i = 2 to obLookback
        if close[i] < open[i]
            obBullH := high[i], obBullL := low[i], obBullBar := bar_index - i
            break
if smcEnabled and impulsoDown
    for i = 2 to obLookback
        if close[i] > open[i]
            obBearH := high[i], obBearL := low[i], obBearBar := bar_index - i
            break

inBullOB = not na(obBullL) and low <= obBullH and close >= obBullL and (bar_index - nz(obBullBar, 0)) < 40
inBearOB = not na(obBearL) and high >= obBearL and close <= obBearH and (bar_index - nz(obBearBar, 0)) < 40

// FVG (Fair Value Gap)
fvgBull = low > high[2] and close[1] > open[1] and (close[1] - open[1]) > atrVal * 0.3
fvgBear = high < low[2] and close[1] < open[1] and (open[1] - close[1]) > atrVal * 0.3

var float lfvgBullB = na, var float lfvgBullT = na
var float lfvgBearB = na, var float lfvgBearT = na
if fvgBull
    lfvgBullB := high[2], lfvgBullT := low
if fvgBear
    lfvgBearB := high, lfvgBearT := low[2]

inFvgBull = not na(lfvgBullB) and low <= lfvgBullT and close >= lfvgBullB
inFvgBear = not na(lfvgBearT) and high >= lfvgBearB and close <= lfvgBearT

// ═══════════════════════════════════════════════════
// SESIONES (oro se mueve más en London+NY)
// ═══════════════════════════════════════════════════

london = hour >= 8  and hour < 16
ny     = hour >= 13 and hour < 21
asia   = hour >= 0  and hour < 8
active = london or ny
sessOK = sessionFilt ? active : true

// ═══════════════════════════════════════════════════
// LAS 3 ESTRATEGIAS DEL BOT (bot.py líneas 2430-2586)
// ═══════════════════════════════════════════════════

// Tendencia fuerte (para bloquear reversiones contra tendencia)
_tendBullFuerte = ema20 > ema50 and ema50 > ema200
_tendBearFuerte = ema20 < ema50 and ema50 < ema200

// EMA200 filtro opcional
ema200BuyOK  = ema200Filt ? close > ema200 : true
ema200SellOK = ema200Filt ? close < ema200 : true

// ATR mínimo (bot: min_atr = 0.2 para oro)
atrOK = atrVal >= MIN_ATR

// ── ESTRATEGIA 1: PULLBACK A TENDENCIA (Score 4) ──
// Bot líneas 2438-2476

pullBuy = close > ema200                          // Tendencia principal alcista
     and ema20 > ema50                             // Estructura alcista
     and macdLine > signalLine                     // MACD alcista
     and low <= ema50 * 1.010                      // Pullback toca EMA50 (1%)
     and close > ema50                             // Cierra por encima
     and rsiVal < (RSI_OS + 15)                    // RSI < 51 (descargado)
     and stochK < 50                               // Estocástico bajo
     and volRatio >= VOL_MIN                       // Volumen mínimo 0.8x
     and atrOK                                     // ATR > $0.20
     and ema200BuyOK

pullSell = close < ema200                          // Tendencia principal bajista
     and ema20 < ema50                             // Estructura bajista
     and macdLine < signalLine                     // MACD bajista
     and high >= ema50 * 0.990                     // Pullback toca EMA50 (1%)
     and close < ema50                             // Cierra por debajo
     and rsiVal > (RSI_OB - 15)                    // RSI > 49
     and stochK > 50                               // Estocástico alto
     and volRatio >= VOL_MIN
     and atrOK
     and ema200SellOK

// ── ESTRATEGIA 2: BREAKOUT DE ALTA CONVICCIÓN (Score 4) ──
// Bot líneas 2478-2518

brkBuy = bbWidthPct < BB_SQUEEZE                   // Bollinger squeeze activo (<1.2%)
     and close > bbUpper                            // Precio rompe BB superior
     and volRatio > 1.5                             // Volumen explosivo >1.5x
     and macdLine > signalLine                      // MACD confirma
     and rsiVal < 75                                // No sobrecomprado extremo
     and adxVal > ADX_MIN                           // Tendencia activa
     and velaCuerpo                                 // Vela con cuerpo
     and atrOK
     and ema200BuyOK

brkSell = bbWidthPct < BB_SQUEEZE                  // Bollinger squeeze activo
     and close < bbLower                            // Precio rompe BB inferior
     and volRatio > 1.5                             // Volumen explosivo
     and macdLine < signalLine                      // MACD confirma
     and rsiVal > 25                                // No sobrevendido extremo
     and adxVal > ADX_MIN
     and velaCuerpo
     and atrOK
     and ema200SellOK

// ── ESTRATEGIA 3: REVERSIÓN EXTREMA CON CONFLUENCIA (Score 4-5) ──
// Bot líneas 2520-2586

// Path A: RSI Divergencia (Score 5)
revDivBuy  = divAlcista and not _tendBearFuerte and velaCuerpo
revDivSell = divBajista and not _tendBullFuerte and velaCuerpo

// Path B: RSI Extremo + Soporte/Resistencia (Score 4)
revExtBuy  = rsiVal < RSI_OS and cercaSoporte and not _tendBearFuerte and velaCuerpo
revExtSell = rsiVal > RSI_OB and cercaResistencia and not _tendBullFuerte and velaCuerpo

// Combinado
revBuy  = revDivBuy  or revExtBuy
revSell = revDivSell or revExtSell

// ── SEÑALES SMC ADICIONALES ──
obBuy    = smcEnabled and inBullOB and rsiVal < 65 and rsiVal > 30 and macdLine > macdLine[1] and volRatio > 0.7 and ema200BuyOK
obSell   = smcEnabled and inBearOB and rsiVal > 35 and rsiVal < 70 and macdLine < macdLine[1] and volRatio > 0.7 and ema200SellOK
fvgBuyS  = smcEnabled and inFvgBull and rsiVal > 35 and rsiVal < 65 and close > close[1] and ema200BuyOK
fvgSellS = smcEnabled and inFvgBear and rsiVal > 35 and rsiVal < 65 and close < close[1] and ema200SellOK
chochBuyS  = smcEnabled and chochUp and volRatio > 0.9 and rsiVal > 30 and rsiVal < 65 and macdLine > signalLine
chochSellS = smcEnabled and chochDown and volRatio > 0.9 and rsiVal > 35 and rsiVal < 70 and macdLine < signalLine

// ── SEÑALES AGREGADAS ──
anyBuy  = pullBuy  or brkBuy  or revBuy  or obBuy  or fvgBuyS  or chochBuyS
anySell = pullSell or brkSell or revSell or obSell or fvgSellS or chochSellS

// Tipo de señal (para el label y webhook)
buyTypeTxt  = pullBuy?"PULLBACK":brkBuy?"BREAKOUT":revDivBuy?"REV_DIV":revExtBuy?"REV_EXTREME":obBuy?"ORDER_BLOCK":fvgBuyS?"FVG":chochBuyS?"CHOCH":"MIX"
sellTypeTxt = pullSell?"PULLBACK":brkSell?"BREAKOUT":revDivSell?"REV_DIV":revExtSell?"REV_EXTREME":obSell?"ORDER_BLOCK":fvgSellS?"FVG":chochSellS?"CHOCH":"MIX"

// Score base de estrategia (bot: 4 o 5)
buyBaseScore  = revDivBuy  ? 5 : (pullBuy or brkBuy or revExtBuy) ? 4 : anyBuy ? 3 : 0
sellBaseScore = revDivSell ? 5 : (pullSell or brkSell or revExtSell) ? 4 : anySell ? 3 : 0

// ═══════════════════════════════════════════════════
// SCORING PONDERADO 0-12 (Simula Multi-IA del bot)
// ═══════════════════════════════════════════════════

// Score BUY (12 componentes)
buyScore = 0
buyScore := buyScore + (ema9 > ema20 and ema20 > ema50 ? 1 : 0)   // EMA alignment
buyScore := buyScore + (close > ema200 ? 1 : 0)                      // Tendencia macro
buyScore := buyScore + (rsiVal > 35 and rsiVal < 65 ? 1 : 0)        // RSI favorable
buyScore := buyScore + (macdLine > signalLine ? 1 : 0)               // MACD dirección
buyScore := buyScore + (histLine > histLine[1] ? 1 : 0)              // MACD aceleración
buyScore := buyScore + (volRatio > VOL_MIN ? 1 : 0)                  // Volumen activo
buyScore := buyScore + (adxVal > ADX_MIN ? 1 : 0)                    // Fuerza tendencia
buyScore := buyScore + (smcEnabled and (inBullOB or inFvgBull) ? 1 : 0)  // Smart Money
buyScore := buyScore + (close > vwapVal ? 1 : 0)                     // Precio > VWAP
buyScore := buyScore + (mtf1hBull ? 1 : 0)                           // MTF 1H confirma
buyScore := buyScore + (divAlcista ? 1 : 0)                          // Divergencia RSI
buyScore := buyScore + (stochK < 50 and stochK > stochD ? 1 : 0)    // Estocástico

// Score SELL (12 componentes)
sellScore = 0
sellScore := sellScore + (ema9 < ema20 and ema20 < ema50 ? 1 : 0)
sellScore := sellScore + (close < ema200 ? 1 : 0)
sellScore := sellScore + (rsiVal > 35 and rsiVal < 65 ? 1 : 0)
sellScore := sellScore + (macdLine < signalLine ? 1 : 0)
sellScore := sellScore + (histLine < histLine[1] ? 1 : 0)
sellScore := sellScore + (volRatio > VOL_MIN ? 1 : 0)
sellScore := sellScore + (adxVal > ADX_MIN ? 1 : 0)
sellScore := sellScore + (smcEnabled and (inBearOB or inFvgBear) ? 1 : 0)
sellScore := sellScore + (close < vwapVal ? 1 : 0)
sellScore := sellScore + (mtf1hBear ? 1 : 0)
sellScore := sellScore + (divBajista ? 1 : 0)
sellScore := sellScore + (stochK > 50 and stochK < stochD ? 1 : 0)

// ═══════════════════════════════════════════════════
// CLASIFICACIÓN PREMIUM / VÁLIDA
// ═══════════════════════════════════════════════════

volOK = volFilterOn ? volRatio > VOL_MIN : true

// Premium: Score >= 8/12 + MTF 1H obligatorio + sesión + régimen
// Válida:  Score >= 6/12 + régimen (sin MTF ni sesión requerida)
buyPremium  = anyBuy  and buyBaseScore >= 4 and buyScore >= 8 and sessOK and volOK and regimeOK and mtf1hBull
buyValid    = anyBuy  and buyScore >= 6 and buyScore < 8 and volOK and regimeOK and not buyPremium
sellPremium = anySell and sellBaseScore >= 4 and sellScore >= 8 and sessOK and volOK and regimeOK and mtf1hBear
sellValid   = anySell and sellScore >= 6 and sellScore < 8 and volOK and regimeOK and not sellPremium

// ═══════════════════════════════════════════════════
// ANTI-SPAM (evitar señales duplicadas)
// ═══════════════════════════════════════════════════

// Anti-spam con cooldowns SEPARADOS buy/sell (antes: compartidos → señales contrarias se pisaban)
var int lastBuyPBar  = 0, var int lastSellPBar = 0
var int lastBuyVBar  = 0, var int lastSellVBar = 0

coolP = 15  // 15 velas cooldown premium (~3.75h en 15m) — antes: 6 = muy poco
coolV = 25  // 25 velas cooldown válida (~6.25h en 15m) — antes: 10 = muy poco

fBuyP  = buyPremium  and showPremium and (bar_index - lastBuyPBar)  > coolP
fSellP = sellPremium and showPremium and (bar_index - lastSellPBar) > coolP
fBuyV  = buyValid    and showValid   and (bar_index - lastBuyVBar)  > coolV and not fBuyP
fSellV = sellValid   and showValid   and (bar_index - lastSellVBar) > coolV and not fSellP

if fBuyP
    lastBuyPBar := bar_index
if fSellP
    lastSellPBar := bar_index
if fBuyV
    lastBuyVBar := bar_index
if fSellV
    lastSellVBar := bar_index

// ═══════════════════════════════════════════════════
// TP / SL DINÁMICO (bot.py líneas 2624-2629)
// ═══════════════════════════════════════════════════

// Base: ATR 1H (como el bot)
_atr1h = nz(atr1H, atrVal * 4)  // Fallback: ATR 15m × 4

// SL basado en ATR 1H — R:R 1.5:1 por diseño (SL=1.0×ATR, TP1=1.5×ATR)
// v1: swing SL $40 + TP1 $15 = R:R 0.38:1 = DD 80%
// v2: cap SL $12 + TP1 $18 = SL demasiado apretado = WR 15% = DD 288%
// v3: SL $25 + TP1 $37 = room to breathe + R:R 1.5:1 = CORRECTO
_slRaw   = _atr1h * finalSl                       // SL base = 1.0 × ATR1H (~$25)
_slFinal = math.max(_slRaw, MIN_SL)               // Floor $10
_slMax   = _atr1h * MAX_SL_MULT                   // Safety cap = 2.0 × ATR1H (~$50)
_slUse   = math.min(_slFinal, _slMax)             // No mayor que safety cap
_slUse  := math.max(_slUse, MIN_SL)               // Nunca menos de $10

slBuy  = close - _slUse
slSell = close + _slUse

// TPs
tp1B = close + _atr1h * finalTp1
tp2B = close + _atr1h * finalTp2
tp3B = close + _atr1h * finalTp3
tp1S = close - _atr1h * finalTp1
tp2S = close - _atr1h * finalTp2
tp3S = close - _atr1h * finalTp3

// ═══════════════════════════════════════════════════
// BACKTESTING INTERNO ($640 capital real)
// ═══════════════════════════════════════════════════

var int   totB = 0, var int totS = 0
var int   wins = 0, var int losses = 0
var float eq   = 640.0, var float peakEq = 640.0, var float maxDD = 0.0
var float ePx  = na, var int eDir = 0, var float eSL = na, var float eTP = na
var int   bse  = 0

// Solo PREMIUM entra al backtest (antes: Premium + Válida → demasiadas entradas basura)
anyBF = fBuyP
anySF = fSellP

// Verificar tendencia antes de entrar (EMA alignment + MTF 1H)
_trendConfirmBuy  = ema9 > ema20 and ema20 > ema50
_trendConfirmSell = ema9 < ema20 and ema20 < ema50

if anyBF and eDir == 0 and _trendConfirmBuy
    ePx := close, eDir := 1, eSL := slBuy, eTP := tp1B, totB += 1, bse := 0
if anySF and eDir == 0 and _trendConfirmSell
    ePx := close, eDir := -1, eSL := slSell, eTP := tp1S, totS += 1, bse := 0
if eDir != 0
    bse += 1

// Cierre en TP1 (como el bot real)
if eDir == 1
    if high >= eTP
        _pnl = math.abs(eTP - ePx)
        wins += 1, eq += _pnl * 0.02 * 100, eDir := 0  // ~0.02 lotes × $100/punto
    else if low <= eSL
        _loss = math.abs(ePx - eSL)
        losses += 1, eq -= _loss * 0.02 * 100, eDir := 0

if eDir == -1
    if low <= eTP
        _pnl3 = math.abs(ePx - eTP)
        wins += 1, eq += _pnl3 * 0.02 * 100, eDir := 0
    else if high >= eSL
        _loss2 = math.abs(eSL - ePx)
        losses += 1, eq -= _loss2 * 0.02 * 100, eDir := 0

peakEq := math.max(peakEq, eq)
dd      = peakEq > 0 ? ((peakEq - eq) / peakEq) * 100 : 0
maxDD  := math.max(maxDD, dd)
wr      = (wins + losses) > 0 ? (wins / (wins + losses)) * 100.0 : 0.0

// ═══════════════════════════════════════════════════
// VISUALIZACIÓN
// ═══════════════════════════════════════════════════

// EMAs
plot(showEMAs ? ema9   : na, "EMA 9",   color.new(color.yellow, 0), 1)
plot(showEMAs ? ema20  : na, "EMA 20",  color.new(color.aqua,   0), 1)
plot(showEMAs ? ema50  : na, "EMA 50",  color.new(color.orange, 0), 2)
plot(showEMAs ? ema200 : na, "EMA 200", color.new(color.red,   30), 3)

// Background por régimen
bgcolor(regimeTend ? color.new(color.green,  95) :
        regimeRang ? color.new(color.orange, 95) :
        regimeVol  ? color.new(color.red,    95) : na)

// FVG boxes
if showFVG and fvgBull
    box.new(bar_index-2, low, bar_index+5, high[2], color.new(color.green, 60), bgcolor=color.new(color.green, 88))
if showFVG and fvgBear
    box.new(bar_index-2, low[2], bar_index+5, high, color.new(color.red, 60), bgcolor=color.new(color.red, 88))

// Order Block boxes
if showOB and smcEnabled and impulsoUp and not na(obBullL)
    box.new(bar_index-obLookback, obBullH, bar_index+2, obBullL,
        color.new(color.blue, 50), bgcolor=color.new(color.blue, 88),
        text="OB+", text_color=color.blue, text_size=size.tiny)
if showOB and smcEnabled and impulsoDown and not na(obBearL)
    box.new(bar_index-obLookback, obBearH, bar_index+2, obBearL,
        color.new(color.purple, 50), bgcolor=color.new(color.purple, 88),
        text="OB-", text_color=color.purple, text_size=size.tiny)

// BOS/CHoCH markers
plotshape(bosUp   and not chochUp,   "BOS+",   shape.triangleup,   location.belowbar, color.new(color.teal, 40),    size=size.tiny)
plotshape(bosDown and not chochDown, "BOS-",   shape.triangledown, location.abovebar, color.new(color.maroon, 40),  size=size.tiny)
plotshape(chochUp,                   "CHoCH+", shape.diamond,      location.belowbar, color.new(color.lime, 0),     size=size.small)
plotshape(chochDown,                 "CHoCH-", shape.diamond,      location.abovebar, color.new(color.fuchsia, 0),  size=size.small)

pFmt = "#.00"
ext  = 20

// ── PREMIUM BUY ──
if fBuyP
    txt = "💎 PREMIUM BUY [" + str.tostring(buyScore) + "/12]\n" + buyTypeTxt + "\nENTRADA: " + str.tostring(close, pFmt) + "\nTP1: " + str.tostring(tp1B, pFmt) + "\nTP2: " + str.tostring(tp2B, pFmt) + "\nTP3: " + str.tostring(tp3B, pFmt) + "\nSL: " + str.tostring(slBuy, pFmt)
    label.new(bar_index, low - atrVal * 0.5, txt, style=label.style_label_up, color=color.new(color.orange, 0), textcolor=color.black, size=size.normal)
    if showTPSL
        line.new(bar_index, close, bar_index+ext, close, color=color.new(color.blue, 0),  style=line.style_solid,  width=2)
        label.new(bar_index+ext, close, "ENT " + str.tostring(close, pFmt), style=label.style_label_left, color=color.new(color.blue, 0), textcolor=color.white, size=size.tiny)
        line.new(bar_index, tp1B, bar_index+ext, tp1B, color=color.new(color.lime, 0),  style=line.style_dotted, width=1)
        label.new(bar_index+ext, tp1B, "TP1 " + str.tostring(tp1B, pFmt), style=label.style_label_left, color=color.new(color.lime, 20), textcolor=color.black, size=size.tiny)
        line.new(bar_index, tp2B, bar_index+ext, tp2B, color=color.new(color.green, 0), style=line.style_dotted, width=2)
        label.new(bar_index+ext, tp2B, "TP2 " + str.tostring(tp2B, pFmt), style=label.style_label_left, color=color.new(color.green, 0), textcolor=color.white, size=size.tiny)
        line.new(bar_index, tp3B, bar_index+ext, tp3B, color=color.new(color.teal, 0),  style=line.style_solid,  width=2)
        label.new(bar_index+ext, tp3B, "TP3 " + str.tostring(tp3B, pFmt), style=label.style_label_left, color=color.new(color.teal, 0), textcolor=color.white, size=size.tiny)
        line.new(bar_index, slBuy, bar_index+ext, slBuy, color=color.new(color.red, 0), style=line.style_dashed, width=2)
        label.new(bar_index+ext, slBuy, "SL " + str.tostring(slBuy, pFmt), style=label.style_label_left, color=color.new(color.red, 0), textcolor=color.white, size=size.tiny)

// ── PREMIUM SELL ──
if fSellP
    txt = "💎 PREMIUM SELL [" + str.tostring(sellScore) + "/12]\n" + sellTypeTxt + "\nENTRADA: " + str.tostring(close, pFmt) + "\nTP1: " + str.tostring(tp1S, pFmt) + "\nTP2: " + str.tostring(tp2S, pFmt) + "\nTP3: " + str.tostring(tp3S, pFmt) + "\nSL: " + str.tostring(slSell, pFmt)
    label.new(bar_index, high + atrVal * 0.5, txt, style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white, size=size.normal)
    if showTPSL
        line.new(bar_index, close, bar_index+ext, close, color=color.new(color.blue, 0), style=line.style_solid, width=2)
        label.new(bar_index+ext, close, "ENT " + str.tostring(close, pFmt), style=label.style_label_left, color=color.new(color.blue, 0), textcolor=color.white, size=size.tiny)
        line.new(bar_index, tp1S, bar_index+ext, tp1S, color=color.new(color.lime, 0), style=line.style_dotted, width=1)
        label.new(bar_index+ext, tp1S, "TP1 " + str.tostring(tp1S, pFmt), style=label.style_label_left, color=color.new(color.lime, 20), textcolor=color.black, size=size.tiny)
        line.new(bar_index, tp2S, bar_index+ext, tp2S, color=color.new(color.green, 0), style=line.style_dotted, width=2)
        label.new(bar_index+ext, tp2S, "TP2 " + str.tostring(tp2S, pFmt), style=label.style_label_left, color=color.new(color.green, 0), textcolor=color.white, size=size.tiny)
        line.new(bar_index, tp3S, bar_index+ext, tp3S, color=color.new(color.teal, 0), style=line.style_solid, width=2)
        label.new(bar_index+ext, tp3S, "TP3 " + str.tostring(tp3S, pFmt), style=label.style_label_left, color=color.new(color.teal, 0), textcolor=color.white, size=size.tiny)
        line.new(bar_index, slSell, bar_index+ext, slSell, color=color.new(color.red, 0), style=line.style_dashed, width=2)
        label.new(bar_index+ext, slSell, "SL " + str.tostring(slSell, pFmt), style=label.style_label_left, color=color.new(color.red, 0), textcolor=color.white, size=size.tiny)

// ── VÁLIDA BUY ──
if fBuyV
    txt = "✅ VÁLIDA BUY [" + str.tostring(buyScore) + "/12]\n" + buyTypeTxt + "\nENTRADA: " + str.tostring(close, pFmt) + "\nTP1: " + str.tostring(tp1B, pFmt) + "\nSL: " + str.tostring(slBuy, pFmt)
    label.new(bar_index, low - atrVal * 0.4, txt, style=label.style_label_up, color=color.new(color.green, 0), textcolor=color.white, size=size.normal)

// ── VÁLIDA SELL ──
if fSellV
    txt = "✅ VÁLIDA SELL [" + str.tostring(sellScore) + "/12]\n" + sellTypeTxt + "\nENTRADA: " + str.tostring(close, pFmt) + "\nTP1: " + str.tostring(tp1S, pFmt) + "\nSL: " + str.tostring(slSell, pFmt)
    label.new(bar_index, high + atrVal * 0.4, txt, style=label.style_label_down, color=color.new(color.lime, 20), textcolor=color.black, size=size.normal)

// ═══════════════════════════════════════════════════
// TABLAS INFO + STATS
// ═══════════════════════════════════════════════════

if showTable
    var table t = table.new(position.top_right, 2, 14, bgcolor=color.new(color.black, 80), border_width=1)
    if barstate.islast
        reg  = regimeTend ? "TENDENCIA" : regimeRang ? "RANGO" : regimeVol ? "VOLATIL" : "TRANSICIÓN"
        smc  = inBullOB ? "OB+" : inBearOB ? "OB-" : inFvgBull ? "FVG+" : inFvgBear ? "FVG-" : "-"
        ses  = london ? "LONDON" : ny ? "NEW YORK" : asia ? "ASIA" : "-"
        mtf  = mtf1hBull ? "BULL ✅" : mtf1hBear ? "BEAR ✅" : "NEUTRAL"
        bsc  = buyScore  >= 7 ? "PREM "  + str.tostring(buyScore)  : buyScore  >= 5 ? "VALID " + str.tostring(buyScore)  : str.tostring(buyScore)
        ssc  = sellScore >= 7 ? "PREM "  + str.tostring(sellScore) : sellScore >= 5 ? "VALID " + str.tostring(sellScore) : str.tostring(sellScore)
        sigBuy  = fBuyP  ? "💎 PREMIUM BUY"  : fBuyV  ? "✅ VÁLIDA BUY"  : "-"
        sigSell = fSellP ? "💎 PREMIUM SELL" : fSellV ? "✅ VÁLIDA SELL" : "-"

        table.cell(t, 0, 0,  "BuySell365 PRO", text_color=color.yellow, text_size=size.small)
        table.cell(t, 1, 0,  "ORO · GOLD",     text_color=color.orange, text_size=size.small)
        table.cell(t, 0, 1,  "Régimen",  text_color=color.gray, text_size=size.tiny)
        table.cell(t, 1, 1,  reg,        text_color=regimeTend?color.green:regimeRang?color.orange:color.red, text_size=size.tiny)
        table.cell(t, 0, 2,  "RSI",      text_color=color.gray, text_size=size.tiny)
        table.cell(t, 1, 2,  str.tostring(rsiVal, "#.1"),
            text_color=rsiVal > RSI_OB ? color.red : rsiVal < RSI_OS ? color.green : color.white, text_size=size.tiny)
        table.cell(t, 0, 3,  "ADX",      text_color=color.gray, text_size=size.tiny)
        table.cell(t, 1, 3,  str.tostring(adxVal, "#.1"),
            text_color=adxVal > ADX_MIN ? color.green : color.orange, text_size=size.tiny)
        table.cell(t, 0, 4,  "ATR 15m",  text_color=color.gray, text_size=size.tiny)
        table.cell(t, 1, 4,  "$" + str.tostring(atrVal, "#.2"), text_color=color.white, text_size=size.tiny)
        table.cell(t, 0, 5,  "ATR 1H",   text_color=color.gray, text_size=size.tiny)
        table.cell(t, 1, 5,  "$" + str.tostring(_atr1h, "#.2"), text_color=color.aqua, text_size=size.tiny)
        table.cell(t, 0, 6,  "Volumen",  text_color=color.gray, text_size=size.tiny)
        table.cell(t, 1, 6,  str.tostring(volRatio, "#.1") + "x",
            text_color=volRatio > 1.3 ? color.green : color.white, text_size=size.tiny)
        table.cell(t, 0, 7,  "SMC",      text_color=color.gray, text_size=size.tiny)
        table.cell(t, 1, 7,  smc,        text_color=color.white, text_size=size.tiny)
        table.cell(t, 0, 8,  "Score BUY",  text_color=color.gray, text_size=size.tiny)
        table.cell(t, 1, 8,  bsc,
            text_color=buyScore >= 7 ? color.orange : buyScore >= 5 ? color.green : color.gray, text_size=size.tiny)
        table.cell(t, 0, 9,  "Score SELL", text_color=color.gray, text_size=size.tiny)
        table.cell(t, 1, 9,  ssc,
            text_color=sellScore >= 7 ? color.orange : sellScore >= 5 ? color.green : color.gray, text_size=size.tiny)
        table.cell(t, 0, 10, "MTF 1H",   text_color=color.gray, text_size=size.tiny)
        table.cell(t, 1, 10, mtf,        text_color=mtf1hBull ? color.green : mtf1hBear ? color.red : color.gray, text_size=size.tiny)
        table.cell(t, 0, 11, "Sesión",   text_color=color.gray, text_size=size.tiny)
        table.cell(t, 1, 11, ses,        text_color=active ? color.green : color.gray, text_size=size.tiny)
        table.cell(t, 0, 12, "Diverge",  text_color=color.gray, text_size=size.tiny)
        table.cell(t, 1, 12, divAlcista ? "ALCISTA" : divBajista ? "BAJISTA" : "-",
            text_color=divAlcista ? color.green : divBajista ? color.red : color.gray, text_size=size.tiny)
        table.cell(t, 0, 13, "Señal",    text_color=color.gray, text_size=size.tiny)
        table.cell(t, 1, 13, sigBuy != "-" ? sigBuy : sigSell,
            text_color=sigBuy != "-" ? color.green : sigSell != "-" ? color.red : color.gray, text_size=size.tiny)

if showStats
    var table s = table.new(position.bottom_right, 2, 7, bgcolor=color.new(color.black, 80), border_width=1)
    if barstate.islast
        wrTxt = (wins + losses) > 0 ? str.tostring(wr, "#.1") + "%" : "N/A"
        table.cell(s, 0, 0, "STATS",       text_color=color.yellow, text_size=size.small)
        table.cell(s, 1, 0, "ORO · GOLD",  text_color=color.orange, text_size=size.tiny)
        table.cell(s, 0, 1, "Win Rate",    text_color=color.gray,   text_size=size.tiny)
        table.cell(s, 1, 1, wrTxt,         text_color=wr > 55 ? color.green : wr > 45 ? color.orange : color.red, text_size=size.tiny)
        table.cell(s, 0, 2, "W / L",       text_color=color.gray,   text_size=size.tiny)
        table.cell(s, 1, 2, str.tostring(wins) + " / " + str.tostring(losses), text_color=color.white, text_size=size.tiny)
        table.cell(s, 0, 3, "Max DD",      text_color=color.gray,   text_size=size.tiny)
        table.cell(s, 1, 3, str.tostring(maxDD, "#.1") + "%",
            text_color=maxDD > 15 ? color.red : color.green, text_size=size.tiny)
        table.cell(s, 0, 4, "Equity",      text_color=color.gray,   text_size=size.tiny)
        table.cell(s, 1, 4, "$" + str.tostring(eq, "#.0"),
            text_color=eq > 640 ? color.green : color.red, text_size=size.tiny)
        table.cell(s, 0, 5, "Señales",     text_color=color.gray,   text_size=size.tiny)
        table.cell(s, 1, 5, str.tostring(totB) + "B / " + str.tostring(totS) + "S", text_color=color.white, text_size=size.tiny)
        table.cell(s, 0, 6, "MT5 Symbol",  text_color=color.gray,   text_size=size.tiny)
        table.cell(s, 1, 6, "GOLD (XM)",   text_color=color.aqua,   text_size=size.tiny)

// ═══════════════════════════════════════════════════
// ALERTAS WEBHOOK JSON (solo PREMIUM)
// ═══════════════════════════════════════════════════

regStr = regimeTend ? "TREND" : regimeRang ? "RANGE" : regimeVol ? "VOLATILE" : "TRANSITION"
smcBS  = inBullOB ? "OB" : inFvgBull ? "FVG" : chochUp ? "CHOCH" : bosUp ? "BOS" : "NONE"
smcSS  = inBearOB ? "OB" : inFvgBear ? "FVG" : chochDown ? "CHOCH" : bosDown ? "BOS" : "NONE"
mtfStr = mtf1hBull ? "BULLISH" : mtf1hBear ? "BEARISH" : "NEUTRAL"

if fBuyP
    alert('{"secret":"guaro_secreto_777","signal":"BUY","quality":"PREMIUM","source":"BuySell365_PRO_ORO","ticker":"' + syminfo.tickerid + '","market":"XAUUSD","price":' + str.tostring(close) + ',"sl":' + str.tostring(slBuy, "#.2") + ',"tp1":' + str.tostring(tp1B, "#.2") + ',"tp2":' + str.tostring(tp2B, "#.2") + ',"tp3":' + str.tostring(tp3B, "#.2") + ',"score":' + str.tostring(buyScore) + ',"type":"' + buyTypeTxt + '","rsi":' + str.tostring(rsiVal, "#.1") + ',"adx":' + str.tostring(adxVal, "#.1") + ',"vol":' + str.tostring(volRatio, "#.1") + ',"regime":"' + regStr + '","smc":"' + smcBS + '","mtf1h":"' + mtfStr + '"}', alert.freq_once_per_bar)

if fSellP
    alert('{"secret":"guaro_secreto_777","signal":"SELL","quality":"PREMIUM","source":"BuySell365_PRO_ORO","ticker":"' + syminfo.tickerid + '","market":"XAUUSD","price":' + str.tostring(close) + ',"sl":' + str.tostring(slSell, "#.2") + ',"tp1":' + str.tostring(tp1S, "#.2") + ',"tp2":' + str.tostring(tp2S, "#.2") + ',"tp3":' + str.tostring(tp3S, "#.2") + ',"score":' + str.tostring(sellScore) + ',"type":"' + sellTypeTxt + '","rsi":' + str.tostring(rsiVal, "#.1") + ',"adx":' + str.tostring(adxVal, "#.1") + ',"vol":' + str.tostring(volRatio, "#.1") + ',"regime":"' + regStr + '","smc":"' + smcSS + '","mtf1h":"' + mtfStr + '"}', alert.freq_once_per_bar)

// ═══════════════════════════════════════════════════
// ALERTCONDITIONS NOMBRADAS (solo PREMIUM)
// ═══════════════════════════════════════════════════

alertcondition(fBuyP,
    title   = "BuySell365 PRO ORO — BUY PREMIUM",
    message = '{"signal":"BUY","quality":"PREMIUM","source":"BuySell365_PRO_ORO","ticker":"{{ticker}}","market":"XAUUSD","price":{{close}},"timeframe":"{{interval}}","time":"{{timenow}}"}')

alertcondition(fSellP,
    title   = "BuySell365 PRO ORO — SELL PREMIUM",
    message = '{"signal":"SELL","quality":"PREMIUM","source":"BuySell365_PRO_ORO","ticker":"{{ticker}}","market":"XAUUSD","price":{{close}},"timeframe":"{{interval}}","time":"{{timenow}}"}')

alertcondition(fBuyP or fSellP,
    title   = "BuySell365 PRO ORO — CUALQUIER PREMIUM",
    message = '{"signal":"ANY","quality":"PREMIUM","source":"BuySell365_PRO_ORO","ticker":"{{ticker}}","market":"XAUUSD","price":{{close}},"timeframe":"{{interval}}","time":"{{timenow}}"}')
